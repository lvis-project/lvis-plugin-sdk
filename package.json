{
  "name": "@lvis/plugin-sdk",
  "version": "13.3.0",
  "private": false,
  "description": "SDK for authoring LVIS plugins. Type contracts (PluginManifest / PluginHostApi / PluginRuntimeContext / RuntimePlugin) re-exported from the host as a single source of truth, a thin build helper (defineLvisPluginConfig) shared across plugin repos, and the SDK-owned skill/agent package schemas the marketplace validates against.",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./build": {
      "types": "./src/build/tsup.ts",
      "import": "./dist/build/tsup.js"
    },
    "./packages": {
      "types": "./dist/packages.d.ts",
      "import": "./dist/packages.js"
    },
    "./schemas/plugin-manifest.schema.json": "./schemas/plugin-manifest.schema.json",
    "./schemas/skill-package.schema.json": "./schemas/skill-package.schema.json",
    "./schemas/agent-package.schema.json": "./schemas/agent-package.schema.json",
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "src",
    "schemas",
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "sync:from-host": "node scripts/sync-from-host.mjs",
    "sync:schema-from-host": "node scripts/sync-schema-from-host.mjs",
    "check:drift": "node scripts/sync-from-host.mjs --check",
    "check:schema-drift": "node scripts/sync-schema-from-host.mjs --check",
    "check:dist-drift": "node scripts/check-dist-drift.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "packageManager": "bun@1.1.38",
  "peerDependencies": {
    "ajv": ">=8.0.0",
    "tsup": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "ajv": {
      "optional": true
    },
    "tsup": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.13",
    "vitest": "^4.1.5"
  }
}
